# This Dockerfile is dedicated to running tests.
# It ensures all dependencies are restored and then executes 'dotnet test'.

# Stage 1: Build Environment
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy the entire api directory content to /src
# This structure is consistent with the other Dockerfiles.
COPY api/ .

# Restore dependencies for all projects in the solution
RUN dotnet restore "nikoniko.slnx"

# Build the solution to ensure all projects compile before testing
RUN dotnet build "nikoniko.slnx" --no-restore

# Stage 2: Test Execution
# The final command runs the tests for the entire solution.
# --logger is used to output test results in a standard format.
ENTRYPOINT ["dotnet", "test", "nikoniko.slnx", "--no-build", "--logger", "trx;LogFileName=test_results.trx"]
