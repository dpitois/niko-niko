# Stage 1: Build the React application
FROM node:24-alpine AS build-frontend
WORKDIR /app

# Copy package.json and package-lock.json from the app/frontend directory
COPY app/frontend/package*.json ./

# Install dependencies using npm ci for faster, reliable builds
RUN npm ci

# Copy the rest of the application source code from app/frontend
COPY app/frontend/ .

# Accept build argument for GitHub Repo URL
ARG VITE_GITHUB_REPO_URL
# Set it as an environment variable so Vite can pick it up
ENV VITE_GITHUB_REPO_URL=$VITE_GITHUB_REPO_URL

# Build the application
RUN npm run build

# Stage 2: Build the Starlight Documentation
FROM node:24-alpine AS build-docs
WORKDIR /app

# Copy package.json and package-lock.json from the docs directory
COPY docs/package*.json ./

# Install dependencies
RUN npm ci

# Copy the rest of the documentation source code
COPY docs/ .

# Build the documentation
# build:api will be skipped if swagger.json is not present
RUN npm run build

# Stage 3: Serve the application using NGINX
# Using alpine-slim for optimized size
FROM nginx:alpine-slim

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy the custom NGINX configuration file
COPY app/frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy React App build artifacts
COPY --from=build-frontend /app/dist /usr/share/nginx/html

# Copy Documentation build artifacts to /docs subdirectory
COPY --from=build-docs /app/dist /usr/share/nginx/html/docs

# Expose port 80
EXPOSE 80

# Start NGINX
ENTRYPOINT ["nginx", "-g", "daemon off;"]
